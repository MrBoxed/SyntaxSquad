{
    "manifest_version": 3,
    "version": "1.0",
    "name": "Bookmark Buzz",
    "description": "An extension to remind you to read a page that you have saved",
    "action": {
        "default_popup": "popup.html",
        "default_icon": "./img/syntaxSquadLogo.png"
    },
    "permissions": [
        "tabs",
        "storage",
        "alarms"
    ],
    "background": {
        "service_worker": "service_worker.js",
        "type": "module"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    }
}